#!/bin/bash
# AI Usage Buddy — Developer ID署名 + 公証（実行前に README も確認）
#
# 使用方法:
#   1. cp scripts/sign-and-notarize.sh.example scripts/sign-and-notarize.sh
#   2. chmod +x scripts/sign-and-notarize.sh
#   3. 必要な環境変数を設定し ./scripts/sign-and-notarize.sh を実行
#
# 環境変数（値をこのファイルやGitへ書かない）:
#   AI_USAGE_BUDDY_SIGNING_IDENTITY  Developer ID Application証明書名
#   AI_USAGE_BUDDY_TEAM_ID           Apple Developer Team ID
#   AI_USAGE_BUDDY_NOTARY_PROFILE    notarytoolのキーチェーンプロファイル名
#   AI_USAGE_BUDDY_BUNDLE_ID         アプリのBundle Identifier
#
# 公証プロファイルは notarytool store-credentials で作成する。
# パスワードはコマンドへ渡さず、対話プロンプトに入力すること。
# このスクリプトはDeveloper ID Application以外では署名しない。
set -euo pipefail

SIGN_ONLY=0
if [[ $# -eq 1 && "$1" == "--sign-only" ]]; then
  SIGN_ONLY=1
elif [[ $# -ne 0 ]]; then
  echo "使い方: $0 [--sign-only]" >&2
  exit 2
fi

MISSING=()
[[ -z "${AI_USAGE_BUDDY_SIGNING_IDENTITY:-}" ]] && MISSING+=("AI_USAGE_BUDDY_SIGNING_IDENTITY")
[[ -z "${AI_USAGE_BUDDY_TEAM_ID:-}" ]] && MISSING+=("AI_USAGE_BUDDY_TEAM_ID")
if [[ "$SIGN_ONLY" -eq 0 && -z "${AI_USAGE_BUDDY_NOTARY_PROFILE:-}" ]]; then
  MISSING+=("AI_USAGE_BUDDY_NOTARY_PROFILE")
fi
[[ -z "${AI_USAGE_BUDDY_BUNDLE_ID:-}" ]] && MISSING+=("AI_USAGE_BUDDY_BUNDLE_ID")
if (( ${#MISSING[@]} > 0 )); then
  echo "署名・公証に必要な環境変数が不足している:" >&2
  printf '  - %s\n' "${MISSING[@]}" >&2
  exit 1
fi

IDENTITY="$AI_USAGE_BUDDY_SIGNING_IDENTITY"
TEAM_ID="$AI_USAGE_BUDDY_TEAM_ID"
NOTARY_PROFILE="${AI_USAGE_BUDDY_NOTARY_PROFILE:-}"
BUNDLE_ID="$AI_USAGE_BUDDY_BUNDLE_ID"

case "$IDENTITY" in
  "Developer ID Application: "*) ;;
  *)
    echo "Developer ID Application証明書だけが使用できる。Apple Development等は不可。" >&2
    exit 1
    ;;
esac
if [[ ! "$TEAM_ID" =~ ^[A-Z0-9]{10}$ ]]; then
  echo "AI_USAGE_BUDDY_TEAM_ID は10文字の英大文字・数字で指定すること。" >&2
  exit 1
fi
IDENTITY_TEAM_ID=$(printf '%s\n' "$IDENTITY" | awk -F '[()]' '{print $(NF-1)}')
if [[ "$IDENTITY_TEAM_ID" != "$TEAM_ID" ]]; then
  echo "証明書名のTeam IDと AI_USAGE_BUDDY_TEAM_ID が一致しない。" >&2
  exit 1
fi

PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
APP_NAME="AI Usage Buddy"
RELEASE_DIR="${AI_USAGE_BUDDY_RELEASE_DIR:-$PROJECT_ROOT/build/release}"
APP_ROOT="$RELEASE_DIR/$APP_NAME.app"
if [[ ! -d "$APP_ROOT" ]]; then
  echo "先に ./scripts/package-release.sh で .app を作成すること: $APP_ROOT" >&2
  exit 1
fi

APP_BUNDLE_ID=$(/usr/libexec/PlistBuddy -c "Print :CFBundleIdentifier" "$APP_ROOT/Contents/Info.plist")
VERSION=$(/usr/libexec/PlistBuddy -c "Print :CFBundleShortVersionString" "$APP_ROOT/Contents/Info.plist")
BUILD=$(/usr/libexec/PlistBuddy -c "Print :CFBundleVersion" "$APP_ROOT/Contents/Info.plist")
if [[ "$APP_BUNDLE_ID" != "$BUNDLE_ID" ]]; then
  echo "Bundle IDが一致しない。指定=$BUNDLE_ID / .app=$APP_BUNDLE_ID" >&2
  exit 1
fi

# 現在のアプリ構造は単一の実行ファイル + リソースのみ。
# ネストした実行コードが増えた場合は、署名対象を明示してからこの前提を更新する。
MAIN_EXECUTABLE="$APP_ROOT/Contents/MacOS/AIUsageBuddy"
if [[ ! -x "$MAIN_EXECUTABLE" ]]; then
  echo "メイン実行ファイルが見つからない、または実行不可: $MAIN_EXECUTABLE" >&2
  exit 1
fi
EXECUTABLE_FILES=$(find "$APP_ROOT/Contents" -type f -perm -111 -print)
EXECUTABLE_COUNT=0
while IFS= read -r CODE_FILE; do
  [[ -z "$CODE_FILE" ]] && continue
  EXECUTABLE_COUNT=$((EXECUTABLE_COUNT + 1))
  if [[ "$CODE_FILE" != "$MAIN_EXECUTABLE" ]]; then
    echo "未対応のネスト実行コードを検出したため停止: $CODE_FILE" >&2
    exit 1
  fi
done <<< "$EXECUTABLE_FILES"
if [[ "$EXECUTABLE_COUNT" -ne 1 ]]; then
  echo "単一実行ファイル構成ではないため停止した（検出数: ${EXECUTABLE_COUNT}）。" >&2
  exit 1
fi

# 有効なDeveloper ID Application identityだけを受け付ける。
IDENTITIES=$(security find-identity -v -p codesigning)
if ! grep -Fq "\"$IDENTITY\"" <<< "$IDENTITIES"; then
  echo "指定したDeveloper ID Application証明書がキーチェーンに見つからない: $IDENTITY" >&2
  exit 1
fi

SIGN_INFO=$(codesign -dv --verbose=4 "$APP_ROOT" 2>&1 || true)
SIGNATURE=$(printf '%s\n' "$SIGN_INFO" | sed -n 's/^Signature=//p' | head -1)
CURRENT_TEAM_ID=$(printf '%s\n' "$SIGN_INFO" | sed -n 's/^TeamIdentifier=//p' | head -1)
CURRENT_IDENTIFIER=$(printf '%s\n' "$SIGN_INFO" | sed -n 's/^Identifier=//p' | head -1)

if [[ "$SIGNATURE" == "adhoc" && ( -z "$CURRENT_TEAM_ID" || "$CURRENT_TEAM_ID" == "not set" ) ]]; then
  echo "==> Hardened Runtime + secure timestamp で署名: $IDENTITY"
  codesign --force --options runtime --timestamp --sign "$IDENTITY" "$APP_ROOT"
elif printf '%s\n' "$SIGN_INFO" | grep -Fxq "Authority=$IDENTITY" &&
     [[ "$CURRENT_TEAM_ID" == "$TEAM_ID" && "$CURRENT_IDENTIFIER" == "$BUNDLE_ID" ]]; then
  echo "==> 一致するDeveloper ID署名を再利用（再署名しない）: $IDENTITY"
else
  echo "既存署名がad-hocでも指定Developer ID署名でもないため、上書きせず停止した。" >&2
  exit 1
fi

codesign --verify --strict "$APP_ROOT"
SIGN_INFO=$(codesign -dv --verbose=4 "$APP_ROOT" 2>&1)
ACTUAL_TEAM_ID=$(printf '%s\n' "$SIGN_INFO" | sed -n 's/^TeamIdentifier=//p' | head -1)
ACTUAL_IDENTIFIER=$(printf '%s\n' "$SIGN_INFO" | sed -n 's/^Identifier=//p' | head -1)
if ! printf '%s\n' "$SIGN_INFO" | grep -Fxq "Authority=$IDENTITY" ||
   [[ "$ACTUAL_TEAM_ID" != "$TEAM_ID" || "$ACTUAL_IDENTIFIER" != "$BUNDLE_ID" ]]; then
  echo "署名後のAuthority / TeamIdentifier / Bundle ID検証に失敗した。" >&2
  exit 1
fi
if ! printf '%s\n' "$SIGN_INFO" | grep -Eq '^CodeDirectory .*flags=[^[:space:]]*\(runtime\)'; then
  echo "Hardened Runtimeが確認できないため公証へ進まない。既存署名は再利用せず、要件を満たす署名を用意すること。" >&2
  exit 1
fi
ACTUAL_TIMESTAMP=$(printf '%s\n' "$SIGN_INFO" | sed -n 's/^Timestamp=//p' | head -1)
if [[ -z "$ACTUAL_TIMESTAMP" || "$ACTUAL_TIMESTAMP" == "none" ]]; then
  echo "secure timestampが確認できないため公証へ進まない。既存署名は再利用せず、要件を満たす署名を用意すること。" >&2
  exit 1
fi

if [[ "$SIGN_ONLY" -eq 1 ]]; then
  echo "==> 公証プロファイル未指定のためローカル署名のみ。公証・ステープルは未実施。"
  AI_USAGE_BUDDY_NOTARIZATION_STATE=pending "$PROJECT_ROOT/scripts/package-release.sh" --reuse-app
  AI_USAGE_BUDDY_NOTARIZATION_STATE=pending "$PROJECT_ROOT/scripts/create-dmg.sh" --reuse-app
  echo "==> 完了: Developer ID署名済み（未公証・未ステープル）"
  exit 0
fi

NOTARIZED_ZIP="$RELEASE_DIR/.notarization-${VERSION}-${BUILD}-$$.zip"
NOTARY_LOG="$RELEASE_DIR/.notarization-${VERSION}-${BUILD}-$$.log"
trap 'rm -f "$NOTARIZED_ZIP" "$NOTARY_LOG"' EXIT
echo "==> 公証用zipを作成して提出（profile: ${NOTARY_PROFILE}）"
ditto -c -k --keepParent "$APP_ROOT" "$NOTARIZED_ZIP"
if ! NOTARY_RESULT=$(xcrun notarytool submit "$NOTARIZED_ZIP" \
    --keychain-profile "$NOTARY_PROFILE" --wait --output-format json 2>"$NOTARY_LOG"); then
  printf '%s\n' "$NOTARY_RESULT" >&2
  cat "$NOTARY_LOG" >&2
  echo "notarytool submit が失敗した。" >&2
  exit 1
fi
printf '%s\n' "$NOTARY_RESULT"
if ! NOTARY_STATUS=$(printf '%s\n' "$NOTARY_RESULT" | /usr/bin/plutil -extract status raw -o - - 2>/dev/null); then
  echo "公証結果のJSONからstatusを読み取れないため停止した。" >&2
  exit 1
fi
if [[ "$NOTARY_STATUS" != "Accepted" ]]; then
  echo "公証結果がAcceptedではないため、ステープルも配布パッケージ作成も行わない。" >&2
  exit 1
fi

echo "==> 公証チケットをステープルして検証"
xcrun stapler staple "$APP_ROOT"
xcrun stapler validate "$APP_ROOT"
spctl --assess --type execute "$APP_ROOT"
codesign --verify --strict "$APP_ROOT"

# 署名・ステープル済みの同一 .app を再ビルドせず梱包する。
echo "==> 最終状態から配布物を作成（アプリは再ビルドしない）"
"$PROJECT_ROOT/scripts/package-release.sh" --reuse-app
"$PROJECT_ROOT/scripts/create-dmg.sh" --reuse-app

echo ""
echo "==> 完了: Developer ID署名・公証・ステープル検証済み"
echo "    公証後は --reuse-app でのみ再梱包すること。"
