// AI Usage Buddy — リリース設定（実運用用）
// テンプレート: config/ReleaseConfig.example.xcconfig
// 秘密情報は書かない（所有者名・リポジトリ名・URL・バージョンのみ）。

APP_MARKETING_VERSION = 1.0.0
APP_BUILD_NUMBER = 1

// GitHub Releases の公開先（https://github.com/morita-hiroyuki0120/ai-usage-buddy）
// 空にすると更新確認なし（手動更新モード）
GITHUB_OWNER = morita-hiroyuki0120

GITHUB_REPOSITORY = ai-usage-buddy

// Sparkle 2 導入は後続作業（HTTPS Appcast + EdDSA署名が整うまで空）
SPARKLE_APPCAST_URL =
